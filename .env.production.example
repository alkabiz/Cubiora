# ==============================================================================
# CUBIORA — MEGA-CENTROS DE DISPENSACIÓN FARMACÉUTICA (AUDIFARMA PMV)
# Plantilla de Variables de Entorno para Producción en Coolify v4.6+
# Base de Datos: Servidor dedicado PostgreSQL / LXC 101 (192.168.1.33:5432)
# ==============================================================================

# ─── 1. SERVIDOR Y EXPOSICIÓN HTTP ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── 2. CONEXIÓN A BASE DE DATOS POSTGRESQL (LXC 101: 192.168.1.33) ───────────
# Conexión en tiempo de ejecución (Rol DML cubiora_app para operaciones del servicio)
DATABASE_URL=postgresql://cubiora_app:60VNv85SK9Ze5WwY170omGZX%2FAYK7FGkQCRKXU1ejCc%3D@192.168.1.33:5432/cubiora_db?schema=public&sslmode=require

# Conexión directa DDL para migraciones y arranque (Rol cubiora_migrator para prisma migrate deploy y seed)
DIRECT_URL=postgresql://cubiora_migrator:Rz3i0ptJyop37qE6i5G8%2F4L7Xlib5lV0HIxH0ztTwrw%3D@192.168.1.33:5432/cubiora_db?schema=public&sslmode=require

# Habilita el handshake sin CA externa en red interna y local (Docker a LXC en LAN)
ALLOW_DOCKER_INTERNAL_DB=true

# ─── 3. SEGURIDAD Y TOKENS ────────────────────────────────────────────────────
COOKIE_SECURE=auto
SESSION_SECRET=cubiora_production_session_secret_ultra_secure_min_32_chars!
DISPLAY_TOKEN=cubiora_production_display_token_ultra_secure_min_32_chars!
CORS_ORIGINS=https://cubiora.samlapspeed.com,https://coolify.samlapspeed.com,http://localhost:5173,http://localhost,http://127.0.0.1
CORS_ORIGIN=https://cubiora.samlapspeed.com,https://coolify.samlapspeed.com,http://localhost:5173,http://localhost,http://127.0.0.1

# ─── 4. PROVISIÓN AUTOMÁTICA Y SEED INSTITUCIONAL ─────────────────────────────
RUN_SEED_ON_BOOT=false
DEFAULT_ADMIN_PASSWORD=Admin2026!*
DEV_SEED_USER_PASSWORD=Admin2026!*

# ─── 5. PARÁMETROS OPERATIVOS Y SLA FARMACÉUTICO ──────────────────────────────
CUBICLE_DAILY_TARGET_SECONDS=600
AWT_TARGET_SECONDS=900
TMM_TARGET_SECONDS=600
BOTTLENECK_QUEUE_SIZE_THRESHOLD=15
BOTTLENECK_OCCUPANCY_RATE_THRESHOLD=0.90
NO_SHOW_MAX_CALLS=3
LOG_LEVEL=info

# ─── 6. INTEGRACIÓN WMS / ERP (PICKING AUTOMATIZADO) ─────────────────────────
WMS_WEBHOOK_URL=
WMS_WEBHOOK_SECRET=

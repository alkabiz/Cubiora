# ==============================================================================
# CUBIORA — MEGA-CENTROS DE DISPENSACIÓN FARMACÉUTICA (AUDIFARMA PMV)
# Plantilla de Variables de Entorno para Producción en Coolify v4.6+
# ==============================================================================

# ─── 1. SERVIDOR Y EXPOSICIÓN HTTP ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── 2. CONEXIÓN A BASE DE DATOS POSTGRESQL (TLS verify-full) ────────────────
# Conexión en tiempo de ejecución (Rol DML cubiora_app con mínimo privilegio)
# Exige FQDN verificable contra el certificado TLS y sslmode=verify-full
DATABASE_URL=postgresql://cubiora_app:<<CUBIORA_APP_PASSWORD>>@<<DB_INTERNAL_FQDN>>:5432/cubiora_db?schema=public&sslmode=verify-full

# Conexión directa DDL solo para migraciones/bootstrap (mantener vacía en el contenedor API de runtime si migra fuera de banda)
DIRECT_URL=postgresql://cubiora_migrator:<<CUBIORA_MIGRATOR_PASSWORD>>@<<DB_INTERNAL_FQDN>>:5432/cubiora_db?schema=public&sslmode=verify-full

# Prohibido en producción: nunca desactivar la validación TLS de servidor PostgreSQL
ALLOW_DOCKER_INTERNAL_DB=false

# Excepciones TLS explícitas (mantener en false salvo aprobación arquitectónica formal)
# Solo activar ALLOW_NUMERIC_IP_EXCEPTION=true si el certificado servidor/CA incluye SAN IP explícito
ALLOW_NUMERIC_IP_EXCEPTION=false
ALLOW_VERIFY_CA_EXCEPTION=false

# Certificado CA institucional (obligatorio: definir ruta montada o contenido PEM inline)
# En Coolify puede pegar el PEM en una línea con escapes \n en DATABASE_CA_CERT
DATABASE_CA_CERT_PATH=/etc/ssl/certs/cubiora-db-ca.crt
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── 3. SEGURIDAD Y TOKENS ────────────────────────────────────────────────────
COOKIE_SECURE=true
SESSION_SECRET=<<GENERATE_WITH_OPENSSL_RAND_BASE64_32>>
DISPLAY_TOKEN=<<GENERATE_WITH_OPENSSL_RAND_BASE64_32>>
CORS_ORIGINS=https://cubiora.samlapspeed.com

# ─── 4. PROVISIÓN AUTOMÁTICA Y SEED INSTITUCIONAL ─────────────────────────────
RUN_SEED_ON_BOOT=false
DEFAULT_ADMIN_PASSWORD=<<INITIAL_ADMIN_PASSWORD_MIN_12_CHARS>>
DEV_SEED_USER_PASSWORD=<<OPERATOR_SEED_PASSWORD_DISTINCT_MIN_12_CHARS>>

# ─── 5. PARÁMETROS OPERATIVOS Y SLA FARMACÉUTICO ──────────────────────────────
CUBICLE_DAILY_TARGET_SECONDS=600
AWT_TARGET_SECONDS=900
TMM_TARGET_SECONDS=600
BOTTLENECK_QUEUE_SIZE_THRESHOLD=15
BOTTLENECK_OCCUPANCY_RATE_THRESHOLD=0.90
NO_SHOW_MAX_CALLS=3
LOG_LEVEL=info

# ─── 6. INTEGRACIÓN WMS / ERP (PICKING AUTOMATIZADO) ─────────────────────────
WMS_WEBHOOK_URL=
WMS_WEBHOOK_SECRET=

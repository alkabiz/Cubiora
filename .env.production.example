# ==============================================================================
# CUBIORA — MEGA-CENTROS DE DISPENSACIÓN FARMACÉUTICA (AUDIFARMA PMV)
# Plantilla de Variables de Entorno para Producción en Coolify v4.6+
# Copie estos valores en el panel "Environment Variables" (Developer View) de Coolify.
# ==============================================================================

# ─── 1. SERVIDOR Y EXPOSICIÓN HTTP ─────────────────────────────────────────────
NODE_ENV=production
# Puerto de exposición en host (Nginx gateway público mapeado por Coolify)
PORT=80

# ─── 2. BASE DE DATOS POSTGRESQL (SERVICIO INTERNO) ───────────────────────────
POSTGRES_USER=cubiora
# Generar una contraseña segura y compleja para PostgreSQL
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here_12345
POSTGRES_DB=cubiora
# Conexión interna de Docker Compose (resolución por DNS interno 'postgres:5432')
DATABASE_URL=postgresql://cubiora:generate_a_secure_postgres_password_here_12345@postgres:5432/cubiora?schema=public

# ─── 3. SEGURIDAD Y RED DOCKER PRIVADA ────────────────────────────────────────
# Habilita el bypass de TLS estricto para redes puente locales y aisladas de Docker Compose
ALLOW_DOCKER_INTERNAL_DB=true
# Secreto criptográfico de firma de cookies y sesiones (MÍNIMO 32 CARACTERES)
SESSION_SECRET=cubiora_production_session_secret_ultra_secure_min_32_chars!
# Token de acceso para pantallas públicas y turneros (MÍNIMO 32 CARACTERES)
DISPLAY_TOKEN=cubiora_production_display_token_ultra_secure_min_32_chars!
# Orígenes CORS permitidos (separados por coma, sin espacios). Ingrese su FQDN de Coolify.
CORS_ORIGINS=https://turnos.audifarma.com.co,http://localhost
CORS_ORIGIN=https://turnos.audifarma.com.co,http://localhost

# ─── 4. PROVISIÓN AUTOMÁTICA Y SEED INSTITUCIONAL ─────────────────────────────
# Ejecuta prisma:seed de forma idempotente al iniciar el contenedor api
RUN_SEED_ON_BOOT=true
# Contraseña asignada a los usuarios seed creados (admin, cajero1..4, recepcion)
DEFAULT_ADMIN_PASSWORD=AudifarmaMasterAdmin2026!
DEV_SEED_USER_PASSWORD=AudifarmaMasterAdmin2026!

# ─── 5. PARÁMETROS OPERATIVOS Y SLA FARMACÉUTICO ──────────────────────────────
# Tiempo Meta de Atención Diaria por Cubículo en segundos (600s = 10 minutos)
CUBICLE_DAILY_TARGET_SECONDS=600
# SLA de Tiempo Promedio de Espera en sala - AWT (900s = 15 minutos)
AWT_TARGET_SECONDS=900
# SLA de Tiempo Medio de Dispensación en ventanilla - TMM (600s = 10 minutos)
TMM_TARGET_SECONDS=600
# Umbral de turnos en cola para disparar alertas de cuello de botella
BOTTLENECK_QUEUE_SIZE_THRESHOLD=15
# Umbral de tasa de ocupación de cubículos para alerta de congestión (90%)
BOTTLENECK_OCCUPANCY_RATE_THRESHOLD=0.90
# Número máximo de llamados a un turno antes de marcar inasistencia (no-show)
NO_SHOW_MAX_CALLS=3
# Nivel de logging del backend (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ─── 6. INTEGRACIÓN WMS / ERP (DISPENSACIÓN Y PICKING AUTOMATIZADO) ───────────
# URL del webhook del sistema de bodegas o dispensadores automáticos (opcional)
WMS_WEBHOOK_URL=
# Clave HMAC secreta para validación de firma en webhooks de picking (opcional)
WMS_WEBHOOK_SECRET=


{
  "name": "cubiora",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web presencial de gestión de turnos para entrega de medicamentos",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter @cubiora/shared build && pnpm db:generate && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate:dev": "pnpm --filter api prisma:migrate:dev",
    "db:seed": "pnpm --filter api prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.3.3",
    "typescript": "6.0.3"
  }
}

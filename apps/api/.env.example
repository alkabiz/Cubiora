# ─── Variables de Entorno de Ejemplo para apps/api (Cubiora PMV) ─────────────
# Copiar este archivo a .env.development.local para desarrollo local (ignorado por git).
# NUNCA versionar contraseñas reales ni cadenas con credenciales de producción.

# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de Datos (PostgreSQL 18) ───────────────────────────────────────────
# Runtime de NestJS (rol cubiora_app con mínimo privilegio DML)
# En desarrollo local: apuntar estrictamente a localhost / 127.0.0.1
DATABASE_URL="postgresql://cubiora_app:<<CUBIORA_APP_PASSWORD>>@localhost:5432/cubiora_dev?schema=public&sslmode=require"

# Conexión directa para Prisma CLI y migraciones (rol cubiora_migrator con DDL)
DIRECT_URL="postgresql://cubiora_migrator:<<CUBIORA_MIGRATOR_PASSWORD>>@localhost:5432/cubiora_dev?schema=public&sslmode=require"

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Secreto para firmar sesiones HTTP-only (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
SESSION_SECRET="<<SESSION_SECRET_MIN_32_CHARS>>"

# Token opaco para pantalla pública de llamados (D-05)
DISPLAY_TOKEN="<<DISPLAY_TOKEN_MIN_32_CHARS>>"

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS="https://cubiora.samlapspeed.com,https://coolify.samlapspeed.com,http://localhost:5173,http://localhost,http://127.0.0.1"

# Política de bandera Secure para cookies (true | false | auto)
COOKIE_SECURE=auto

# ─── Seed de Desarrollo ──────────────────────────────────────────────────────
# Contraseña unificada para usuarios semilla generados por seed.ts (cajero, recepcion, admin)
DEFAULT_ADMIN_PASSWORD="Admin2026!*"
DEV_SEED_USER_PASSWORD="Admin2026!*"

# ─── Logging ─────────────────────────────────────────────────────────────────
# Niveles: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ─── Negocio ────────────────────────────────────────────────────────────────
# Cantidad máxima de llamados antes de marcar como NO_SHOW (D-07)
NO_SHOW_MAX_CALLS=3

# Objetivo operativo del rendimiento diario por cubículo (segundos).
# 600 = atenciones finalizadas en 10 minutos o menos (SLA estándar).
CUBICLE_DAILY_TARGET_SECONDS=600

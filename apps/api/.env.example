# Variables de entorno para apps/api
# Copiar este archivo como .env y completar los valores reales.
# NUNCA versionar el archivo .env real.

# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos ────────────────────────────────────────────────────────────
# URL de tiempo de ejecución (usuario cubiora_app — mínimo privilegio: SELECT, INSERT, UPDATE, DELETE)
# Para desarrollo local usar el PostgreSQL efímero de docker-compose.dev.yml
DATABASE_URL=postgresql://cubiora_app:PLACEHOLDER_APP_PASSWORD@localhost:5432/cubiora?schema=public

# URL directa para migraciones (usuario cubiora_migrator — más permisos)
# Solo debe estar presente en entornos con capacidad de hacer migraciones
DIRECT_URL=postgresql://cubiora_migrator:PLACEHOLDER_MIGRATOR_PASSWORD@localhost:5432/cubiora?schema=public

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Secreto para firmar sesiones — mínimo 64 caracteres aleatorios en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=PLACEHOLDER_CHANGE_THIS_IN_PRODUCTION_MIN_64_CHARS

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────────────────────
# Niveles: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ─── Turnos / Negocio ────────────────────────────────────────────────────────
# Cantidad máxima de llamados antes de marcar un turno como NO_SHOW
# Valor provisional — pendiente de validar con operación (ver docs/adr/0001-postgresql.md)
NO_SHOW_MAX_CALLS=3

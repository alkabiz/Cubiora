datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserRole {
  RECEPTION
  CASHIER
  ADMIN
}

enum CubicleStatus {
  AVAILABLE
  RESERVED
  CALLING
  BUSY
  INACTIVE
}

enum TicketStatus {
  PENDING
  ASSIGNED
  CALLED
  IN_SERVICE
  CLOSED
  NO_SHOW
  CANCELLED
}

enum QueueCategory {
  GENERAL
  PREFERENTIAL
  HIGH_COST
  BILLING
}

enum DispensationResolution {
  TOTAL_DELIVERED
  PENDING_48H
  PRESCRIPTION_REJECTED
  CANCELLED_BY_PATIENT
}

enum FacilityStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PharmacistOperationalRole {
  TITULAR
  ADJUNTO
  DISPENSADOR
  GUARDIA
}

enum WorkShift {
  MORNING
  AFTERNOON
  NIGHT
  ROTATING
}

enum PharmacistStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model User {
  id           String   @id @db.VarChar(26)
  publicId     String   @unique @map("public_id") @db.VarChar(26)
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(100)
  role         UserRole @default(RECEPTION)
  cubicleId    String?  @unique @map("cubicle_id") @db.VarChar(26)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cubicle           Cubicle?              @relation("CubicleCurrentOperator", fields: [cubicleId], references: [id], onDelete: SetNull)
  pharmacistProfile Pharmacist?
  statusHistory     TicketStatusHistory[]
  callsMade         TicketCall[]
  ticketsCreated    Ticket[]
  dispensations     DispensationRecord[]
  idempotencyKeys   IdempotencyKey[]

  @@map("users")
}

model Facility {
  id                   String         @id @db.VarChar(26)
  code                 String         @unique @db.VarChar(30)
  name                 String         @db.VarChar(120)
  address              String         @db.VarChar(200)
  city                 String         @db.VarChar(80)
  phone                String         @db.VarChar(50)
  openingHours         String         @map("opening_hours") @db.VarChar(80)
  enabledCubiclesCount Int            @default(4) @map("enabled_cubicles_count")
  status               FacilityStatus @default(ACTIVE)
  isPrimary            Boolean        @default(false) @map("is_primary")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cubicles    Cubicle[]
  pharmacists Pharmacist[]
  tickets     Ticket[]

  @@map("facilities")
}

model Cubicle {
  id                String          @id @db.VarChar(26)
  code              String          @unique @db.VarChar(20)
  displayName       String          @map("display_name") @db.VarChar(50)
  operatorName      String?         @map("operator_name") @db.VarChar(120)
  status            CubicleStatus   @default(AVAILABLE)
  active            Boolean         @default(true)
  allowedCategories QueueCategory[] @default([GENERAL, PREFERENTIAL, HIGH_COST, BILLING]) @map("allowed_categories")
  facilityId        String?         @map("facility_id") @db.VarChar(26)
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility        Facility?             @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  currentOperator User?                 @relation("CubicleCurrentOperator")
  pharmacists     Pharmacist[]
  tickets         Ticket[]
  calls           TicketCall[]
  statusHistory   TicketStatusHistory[]
  dispensations   DispensationRecord[]

  @@unique([id, facilityId], name: "uq_cubicles_id_facility")
  @@index([facilityId], name: "ix_cubicles_facility")
  @@map("cubicles")
}

model Pharmacist {
  id              String                    @id @db.VarChar(26)
  fullName        String                    @map("full_name") @db.VarChar(120)
  licenseNumber   String                    @unique @map("license_number") @db.VarChar(40)
  operationalRole PharmacistOperationalRole @default(TITULAR) @map("operational_role")
  shift           WorkShift                 @default(MORNING)
  status          PharmacistStatus          @default(ACTIVE)
  email           String                    @unique @db.VarChar(120)
  phone           String                    @db.VarChar(40)
  dispatchesCount Int                       @default(0) @map("dispatches_count")
  facilityId      String?                   @map("facility_id") @db.VarChar(26)
  cubicleId       String?                   @map("cubicle_id") @db.VarChar(26)
  userId          String?                   @unique @map("user_id") @db.VarChar(26)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  cubicle  Cubicle?  @relation(fields: [cubicleId, facilityId], references: [id, facilityId], onDelete: SetNull, onUpdate: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([facilityId], name: "ix_pharmacists_facility")
  @@index([cubicleId], name: "ix_pharmacists_cubicle")
  @@index([status], name: "ix_pharmacists_status")
  @@map("pharmacists")
}

model SystemSequence {
  sequenceName String   @id @map("sequence_name") @db.VarChar(50)
  nextValue    BigInt   @default(1) @map("next_value")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_sequences")
}

model Ticket {
  id                  String        @id @db.VarChar(26)
  publicId            String        @unique @map("public_id") @db.VarChar(26)
  sequenceNumber      BigInt        @unique @map("sequence_number")
  publicCode          String        @unique @map("public_code") @db.VarChar(20)
  patientName         String        @map("patient_name") @db.VarChar(100)
  patientDocument     String?       @map("patient_document") @db.VarChar(30)
  prescriptionBarcode String?       @map("prescription_barcode") @db.VarChar(60)
  status              TicketStatus  @default(PENDING)
  queueCategory       QueueCategory @default(GENERAL) @map("queue_category")
  preferentialReason  String?       @map("preferential_reason") @db.VarChar(100)
  cubicleId           String?       @map("cubicle_id") @db.VarChar(26)
  facilityId          String?       @map("facility_id") @db.VarChar(26)
  createdBy           String        @map("created_by") @db.VarChar(26)
  assignedAt          DateTime?     @map("assigned_at") @db.Timestamptz(3)
  calledAt            DateTime?     @map("called_at") @db.Timestamptz(3)
  serviceStartedAt    DateTime?     @map("service_started_at") @db.Timestamptz(3)
  closedAt            DateTime?     @map("closed_at") @db.Timestamptz(3)
  terminalReason      String?       @map("terminal_reason") @db.VarChar(255)
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cubicle       Cubicle?              @relation(fields: [cubicleId], references: [id], onDelete: SetNull)
  facility      Facility?             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  creator       User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  calls         TicketCall[]
  statusHistory TicketStatusHistory[]
  dispensation  DispensationRecord?

  @@index([status, sequenceNumber], name: "ix_tickets_status_sequence")
  @@index([status, queueCategory, sequenceNumber], name: "ix_tickets_status_category_sequence")
  @@index([facilityId, status, queueCategory, sequenceNumber], name: "ix_tickets_facility_queue")
  @@index([cubicleId, status], name: "ix_tickets_cubicle_status")
  @@index([patientDocument, status], name: "ix_tickets_document_status")
  @@index([prescriptionBarcode], name: "ix_tickets_prescription")
  @@index([createdBy], name: "ix_tickets_created_by")
  @@map("tickets")
}

model TicketStatusHistory {
  id            String        @id @db.VarChar(26)
  ticketId      String        @map("ticket_id") @db.VarChar(26)
  fromStatus    TicketStatus? @map("from_status")
  toStatus      TicketStatus  @map("to_status")
  cubicleId     String?       @map("cubicle_id") @db.VarChar(26)
  actorUserId   String?       @map("actor_user_id") @db.VarChar(26)
  reasonCode    String?       @map("reason_code") @db.VarChar(50)
  correlationId String        @map("correlation_id") @db.VarChar(36)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  cubicle Cubicle? @relation(fields: [cubicleId], references: [id], onDelete: Restrict)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id], name: "ix_history_ticket_time")
  @@index([createdAt, id], name: "ix_history_time")
  @@map("ticket_status_history")
}

model TicketCall {
  id         String   @id @db.VarChar(26)
  ticketId   String   @map("ticket_id") @db.VarChar(26)
  cubicleId  String   @map("cubicle_id") @db.VarChar(26)
  calledBy   String   @map("called_by") @db.VarChar(26)
  callNumber Int      @default(1) @map("call_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  cubicle Cubicle @relation(fields: [cubicleId], references: [id], onDelete: Restrict)
  caller  User    @relation(fields: [calledBy], references: [id], onDelete: Restrict)

  @@unique([ticketId, callNumber], name: "uq_ticket_calls_call_number")
  @@index([createdAt, id], name: "ix_calls_recent")
  @@index([cubicleId, createdAt], name: "ix_calls_cubicle_time")
  @@map("ticket_calls")
}

model IdempotencyKey {
  id               String   @id @db.VarChar(26)
  actorUserId      String   @map("actor_user_id") @db.VarChar(26)
  operation        String   @db.VarChar(50)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(100)
  requestHash      String   @map("request_hash") @db.VarChar(64)
  resourceType     String?  @map("resource_type") @db.VarChar(50)
  resourcePublicId String?  @map("resource_public_id") @db.VarChar(26)
  responseStatus   Int?     @map("response_status")
  responseBody     Json?    @map("response_body")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, operation, idempotencyKey], name: "uq_idempotency_key")
  @@index([expiresAt], name: "ix_idempotency_expiry")
  @@map("idempotency_keys")
}

model DispensationRecord {
  id                  String                 @id @db.VarChar(26)
  ticketId            String                 @unique @map("ticket_id") @db.VarChar(26)
  cubicleId           String                 @map("cubicle_id") @db.VarChar(26)
  operatorUserId      String                 @map("operator_user_id") @db.VarChar(26)
  resolution          DispensationResolution @map("resolution")
  prescriptionCode    String?                @map("prescription_code") @db.VarChar(60)
  mipresNumber        String?                @map("mipres_number") @db.VarChar(60)
  itemsDeliveredCount Int                    @default(0) @map("items_delivered_count")
  itemsPendingCount   Int                    @default(0) @map("items_pending_count")
  pendingDetailsJson  Json?                  @map("pending_details_json")
  deliveryAddress     String?                @map("delivery_address") @db.VarChar(255)
  deliveryPhone       String?                @map("delivery_phone") @db.VarChar(30)
  deliveryDeadline    DateTime?              @map("delivery_deadline") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket       Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  cubicle      Cubicle @relation(fields: [cubicleId], references: [id], onDelete: Restrict)
  operatorUser User    @relation(fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@index([resolution, deliveryDeadline], name: "ix_dispensations_pending_deadline")
  @@index([operatorUserId], name: "ix_dispensations_operator")
  @@map("dispensation_records")
}

# ─── Dockerfile.web (React 19 + Vite + Nginx) ────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# ─── Etapa 1: Dependencias ────────────────────────────────────────────────────
FROM base AS dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# ─── Etapa 2: Compilación ─────────────────────────────────────────────────────
FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=dependencies /app/apps/web/node_modules ./apps/web/node_modules

COPY . .

RUN pnpm --filter @cubiora/shared build
RUN pnpm --filter web build

# ─── Etapa 3: Servidor Nginx Final ────────────────────────────────────────────
FROM nginx:stable-alpine AS runner

# Copiar artefactos estáticos de React compilados
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Configuración optimizada de Nginx como Reverse Proxy y servidor SPA
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# syntax=docker/dockerfile:1.7
# ─── Dockerfile.web (React 19 + Vite + Nginx) ────────────────────────────────
FROM node:22-alpine@sha256:5b05da3f938f1c604b24c633646d48805a6667f378cb4908438616f3cc48a0bf AS builder
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI="true"

# Fijar pnpm 12.11.2 una sola vez en la capa base
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate

WORKDIR /app

# 1. Copiar manifiestos del workspace web + shared
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# 2. Instalar exclusivamente dependencias de web y shared usando caché persistente de BuildKit
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --filter web... --frozen-lockfile

# 3. Copiar solo el código de shared y web (cambios en apps/api no invalidan el caché de web)
COPY tsconfig*.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# 4. Compilar shared y web en una sola capa
RUN pnpm --filter @cubiora/shared build && \
    pnpm --filter web build

# ─── Etapa 2: Servidor Nginx Final ───────────────────────────────────────────
FROM nginx:stable-alpine@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311 AS runner

# Copiar artefactos estáticos de React compilados con propiedad segura y permisos de lectura
COPY --chown=nginx:nginx --from=builder /app/apps/web/dist /usr/share/nginx/html

# Configuración optimizada de Nginx como Reverse Proxy y servidor SPA
COPY --chown=nginx:nginx docker/nginx.conf /etc/nginx/conf.d/default.conf

# Endurecimiento para ejecución estricta como usuario no-root `nginx` manteniendo puerto 80
RUN apk add --no-cache libcap && \
    setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx && \
    apk del --no-network libcap && \
    sed -i 's|/run/nginx.pid|/tmp/nginx.pid|g; s|/var/run/nginx.pid|/tmp/nginx.pid|g; /^user /d' /etc/nginx/nginx.conf && \
    mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html && \
    touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid

USER nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

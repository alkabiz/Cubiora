# syntax=docker/dockerfile:1.7
# ─── Dockerfile.web (React 19 + Vite + Nginx) ────────────────────────────────
FROM node:22-alpine AS builder
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI="true"

# Fijar pnpm 12.11.2 una sola vez en la capa base
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate

WORKDIR /app

# 1. Copiar manifiestos del workspace web + shared
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# 2. Instalar exclusivamente dependencias de web y shared usando caché persistente de BuildKit
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --filter web... --frozen-lockfile

# 3. Copiar solo el código de shared y web (cambios en apps/api no invalidan el caché de web)
COPY tsconfig*.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# 4. Compilar shared y web en una sola capa
RUN pnpm --filter @cubiora/shared build && \
    pnpm --filter web build

# ─── Etapa 2: Servidor Nginx Final ───────────────────────────────────────────
FROM nginx:stable-alpine AS runner

# Copiar artefactos estáticos de React compilados
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Configuración optimizada de Nginx como Reverse Proxy y servidor SPA
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

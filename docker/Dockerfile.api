# syntax=docker/dockerfile:1.7
# ─── Dockerfile.api (NestJS + Prisma 7 + PostgreSQL) ─────────────────────────
FROM node:22-alpine@sha256:5b05da3f938f1c604b24c633646d48805a6667f378cb4908438616f3cc48a0bf AS base
ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/pnpm/corepack"
ENV PATH="$PNPM_HOME:$PATH"

# Habilitar corepack y fijar el binario y caché de pnpm en /pnpm (accesible para USER node)
RUN mkdir -p /pnpm /pnpm/corepack /home/node/.cache && \
    corepack enable && \
    corepack prepare pnpm@12.11.2 --activate

WORKDIR /app

# ─── Etapa 1: Builder (Instalación con caché BuildKit + Compilación) ─────────
FROM base AS builder
ENV CI="true"
ENV DIRECT_URL="postgresql://cubiora_build:cubiora_build@localhost:5432/cubiora_build"
ENV DATABASE_URL="postgresql://cubiora_build:cubiora_build@localhost:5432/cubiora_build"

# 1. Copiar solo manifiestos para maximizar el acierto de caché de capas Docker
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

# 2. Instalar solo el grafo de api y shared reutilizando la caché persistente en el host
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --filter api... --frozen-lockfile

# 3. Copiar el código fuente y compilar en un solo paso sin re-invocar red
COPY tsconfig*.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN pnpm --filter @cubiora/shared build && \
    pnpm --filter api prisma:generate && \
    pnpm --filter api build

# 4. Aislar dependencias de producción limpias (prisma y tsx permanecen por dependencies)
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    rm -rf node_modules apps/api/node_modules packages/shared/node_modules && \
    pnpm --filter api... install --prod --frozen-lockfile

# ─── Etapa 2: Runner de Producción ───────────────────────────────────────────
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copiar únicamente el workspace de api y shared (sin devDependencies ni artefactos de web)
COPY --chown=node:node --from=builder /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --chown=node:node --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --chown=node:node --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --chown=node:node --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --chown=node:node --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --chown=node:node --from=builder /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --chown=node:node --from=builder /app/apps/api/src/generated ./apps/api/src/generated
COPY --chown=node:node --from=builder /app/apps/api/dist ./apps/api/dist

# Copiar script de entrada con permisos de solo ejecución para usuario no-root
COPY --chmod=0755 docker/entrypoint.api.sh /usr/local/bin/entrypoint.api.sh

# Asegurar permisos completos sobre /pnpm, /app y /home/node antes de cambiar a USER node
RUN mkdir -p /pnpm /home/node/.cache && \
    chown -R node:node /pnpm /app /home/node

USER node

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.api.sh"]
